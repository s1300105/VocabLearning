# Copy this file to .env and fill in the values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me   # python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=True
# Extra hosts / origins, comma separated (localhost and *.ngrok-free.app are allowed by default)
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Twilio Video
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
# Optional: URL that receives Twilio room status callbacks
TWILIO_STATUS_CALLBACK_URL=

# OpenAI (Whisper / TTS)
OPENAI_API_KEY=

# Local LLM (llama.cpp GGUF file)
LLM_MODEL_PATH=/path/to/Phi-3-mini-4k-instruct-q4.gguf

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Hugging Face (optional)
HUGGINGFACE_TOKEN=
